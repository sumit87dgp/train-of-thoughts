# Copy to infra/config.env (gitignored) and fill in values.
# Used by infra/*.sh — never commit real passwords.

# Azure
SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-tot-prod
LOCATION=centralindia
NAME_PREFIX=tot

# Derived names (override if needed)
# POSTGRES_SERVER=${NAME_PREFIX}-pg
# WEBAPP_NAME=${NAME_PREFIX}-api
# APP_SERVICE_PLAN=${NAME_PREFIX}-plan
# APP_INSIGHTS_NAME=${NAME_PREFIX}-ai
# STATIC_WEB_APP_NAME=${NAME_PREFIX}-web

# SKUs (NFR-12 cost-conscious defaults)
APP_SERVICE_SKU=B1
POSTGRES_SKU=Standard_B1ms
POSTGRES_STORAGE_GB=32
POSTGRES_BACKUP_RETENTION_DAYS=7
POSTGRES_VERSION=16

# Postgres admin (tot_owner) — use a strong password; not committed
TOT_OWNER_PASSWORD=

# Optional: your public IP for psql/migrate from laptop (leave empty to skip)
# CLIENT_IP=

# Static Web Apps Free tier locations: eastasia, eastus2, westus2, westeurope, centralus
# (may differ from LOCATION for App Service / Postgres)
STATIC_WEB_APP_LOCATION=eastasia

# Set after SWA is created (https://<name>.azurestaticapps.net)
# CORS_ORIGINS=https://your-app.azurestaticapps.net
